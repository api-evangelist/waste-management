                "value": ""
              },
              {
                "name": "ClientId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "The unique WM customer identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the status of services occurring today for commercial or residential customers."
        },
        {
