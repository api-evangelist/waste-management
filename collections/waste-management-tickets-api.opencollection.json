{
  "opencollection": "1.0.0",
  "info": {
    "name": "Waste Management Customer Cases Tickets API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Tickets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Tickets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wm.com/v1/customers/:customerId/tickets",
            "headers": [
              {
                "name": "Request-Tracking-Id",
                "value": ""
              },
              {
                "name": "ClientId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "The unique WM customer identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves support and disposal tickets associated with the customer account."
        }
      ]
    }
  ],
  "bundled": true
}