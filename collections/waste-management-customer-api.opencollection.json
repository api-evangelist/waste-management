      },
      "items": [
        {
          "info": {
            "name": "Get Customer Overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wm.com/v1/customers",
            "headers": [
              {
                "name": "Request-Tracking-Id",
                "value": ""
              },
              {
                "name": "ClientId",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves customer account overview including balance due, contact and profile information, and services summary."
